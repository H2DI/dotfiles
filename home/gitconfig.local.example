# Template for ~/.gitconfig.local — machine-local git identity + settings.
# Copy to ~/.gitconfig.local and fill in. Included last by ~/.gitconfig, so it
# wins on any conflicting key. NEVER commit it.
[user]
	name = Your Name
	email = you@example.com
	# signingkey = key::ssh-... (only if you sign commits on this machine)

# Uncomment if you sign commits AND the signing key exists on this machine.
# [gpg]
# 	format = ssh
# [commit]
# 	gpgsign = true
# [tag]
# 	gpgsign = true

# Credential helper — path to gh differs per machine.
# [credential "https://github.com"]
# 	helper =
# 	helper = !/usr/bin/gh auth git-credential

# Shared/NFS safe dirs, if any.
# [safe]
# 	directory = /path/to/shared/repo

# Only if git-lfs is installed on this machine.
# [filter "lfs"]
# 	clean = git-lfs clean -- %f
# 	smudge = git-lfs smudge -- %f
# 	process = git-lfs filter-process
# 	required = true

# Needs the `code` CLI.
# [diff]
# 	tool = vscode
# [difftool "vscode"]
# 	cmd = code --wait --diff $LOCAL $REMOTE
