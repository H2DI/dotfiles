{
    "latex-workshop.view.pdf.viewer": "tab",
    "latex-workshop.view.pdf.external.synctex.command": "ctrl-click",
    "latex-workshop.hover.preview.enabled": false,
    "lean4InlineGoals.pythonPath": "/Users/hadiji/anaconda3/envs/ds_prover2/bin/python",
    "python.formatting.provider": "none",
    "notebook.formatOnSave.enabled": true,
    "python.condaPath": "/Users/hedihadiji/anaconda3/",
    // "python.formatting.blackPath": "/Users/hedihadiji/opt/anaconda3/envs/py39/bin/black",
    "python.defaultInterpreterPath": "/Users/hadiji/anaconda3/envs/chess-env/bin/python",
    "terminal.integrated.inheritEnv": false,
    "interactiveWindow.alwaysScrollOnNewCell": false,
    "editor.formatOnSave": false,
    "[python]": {
        "editor.formatOnSave": true,
        "editor.formatOnType": true,
        // "editor.defaultFormatter": "ms-python.black-formatter"
        "editor.defaultFormatter": "charliermarsh.ruff"
    },
    "editor.autoClosingBrackets": "never",
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk",
            "command": "latexmk",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-pdf",
                "-outdir=%OUTDIR%",
                "%DOCFILE%"
            ],
            "env": {}
        },
        {
            "name": "lualatexmk",
            "command": "latexmk",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-lualatex",
                "-outdir=%OUTDIR%",
                "%DOC%"
            ],
            "env": {}
        },
        {
            "name": "xelatexmk",
            "command": "latexmk",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-xelatex",
                "-outdir=%OUTDIR%",
                "%DOC%"
            ],
            "env": {}
        },
        {
            "name": "latexmk_rconly",
            "command": "latexmk",
            "args": [
                "%DOC%"
            ],
            "env": {}
        },
        {
            "name": "pdflatex",
            "command": "pdflatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "%DOC%"
            ],
            "env": {}
        },
        {
            "name": "bibtex",
            "command": "bibtex",
            "args": [
                "%DOCFILE%"
            ],
            "env": {}
        },
        {
            "name": "rnw2tex",
            "command": "Rscript",
            "args": [
                "-e",
                "knitr::opts_knit$set(concordance = TRUE); knitr::knit('%DOCFILE_EXT%')"
            ],
            "env": {}
        },
        {
            "name": "jnw2tex",
            "command": "julia",
            "args": [
                "-e",
                "using Weave; weave(\"%DOC_EXT%\", doctype=\"tex\")"
            ],
            "env": {}
        },
        {
            "name": "jnw2texmintex",
            "command": "julia",
            "args": [
                "-e",
                "using Weave; weave(\"%DOC_EXT%\", doctype=\"texminted\")"
            ],
            "env": {}
        },
        {
            "name": "tectonic",
            "command": "tectonic",
            "args": [
                "--synctex",
                "--keep-logs",
                "%DOC%.tex"
            ],
            "env": {}
        }
    ],
    "security.workspace.trust.untrustedFiles": "open",
    "jupyter.logKernelOutputSeparately": true,
    "vim.camelCaseMotion.enable": true,
    "vim.cursorStylePerMode.normal": "block",
    "vim.easymotion": true,
    "vim.leader": "<space>",
    "vim.vimrc.enable": true,
    "vim.insertModeKeyBindingsNonRecursive": [
        {
            "before": [
                "j",
                "k"
            ],
            "after": [
                "<Esc>"
            ]
        },
    ],
    "editor.suggest.showWords": false,
    "workbench.activityBar.location": "hidden",
    "editor.accessibilitySupport": "off",
    "editor.renderWhitespace": "none",
    "editor.renderControlCharacters": false,
    "editor.minimap.enabled": false,
    "editor.lineNumbers": "relative",
    "latex-workshop.intellisense.optionalArgsEntries.enabled": false,
    "window.zoomLevel": 1,
    "[latex]": {
        "editor.defaultFormatter": "James-Yu.latex-workshop"
    },
    "latexindent.useDocumentFormat": true,
    "editor.rulers": [
        90
    ],
    "latex-workshop.latexindent.args": [
        "-c",
        "%DIR%/",
        "%TMPFILE%",
        "-y=defaultIndent: '%INDENT%'",
        "-m"
    ],
    // "editor.glyphMargin": false,
    "latex-workshop.message.warning.show": false,
    "latex-workshop.latex.recipes": [

        {
            "name": "latexmk",
            "tools": [
                "latexmk"
            ]
        },
        {
            "name": "latexmk (latexmkrc)",
            "tools": [
                "latexmk_rconly"
            ]
        },
        {
            "name": "latexmk (lualatex)",
            "tools": [
                "lualatexmk"
            ]
        },
        {
            "name": "latexmk (xelatex)",
            "tools": [
                "xelatexmk"
            ]
        },
        {
            "name": "pdflatex -> bibtex -> pdflatex * 2",
            "tools": [
                "pdflatex",
                "bibtex",
                "pdflatex",
                "pdflatex"
            ]
        },
        {
            "name": "Compile Rnw files",
            "tools": [
                "rnw2tex",
                "latexmk"
            ]
        },
        {
            "name": "Compile Jnw files",
            "tools": [
                "jnw2tex",
                "latexmk"
            ]
        },
        {
            "name": "Compile Pnw files",
            "tools": [
                "pnw2tex",
                "latexmk"
            ]
        },
        {
            "name": "tectonic",
            "tools": [
                "tectonic"
            ]
        }
    ],
    "editor.wordWrap": "wordWrapColumn",
    "editor.wordWrapColumn": 90,
    "emmet.syntaxProfiles": {},
    "editor.tokenColorCustomizations": {},
    "files.associations": {
        "*.tree": "latex"
    },
    "security.promptForLocalFileProtocolHandling": false,
    "latex-workshop.latexindent.path": "/opt/homebrew/bin/latexindent",
    "python.analysis.inlayHints.functionReturnTypes": true,
    "latex-workshop.formatting.latex": "latexindent",
    "latex-workshop.formatting.latexindent.path": "/opt/homebrew/bin/latexindent",
    "latex-workshop.formatting.latexindent.args": [
        "-c",
        "%DIR%/",
        "%TMPFILE%",
        "-y=defaultIndent: '%INDENT%'",
        "-m"
    ],
    "vim.visualModeKeyBindings": [],
    "vim.enableNeovim": true,
    "vim.neovimPath": "/opt/homebrew/bin/nvim",
    "vim.insertModeKeyBindings": [

    ],
    "vim.sneak": true,
    "github.copilot.editor.enableAutoCompletions": false,
    "github.copilot.nextEditSuggestions.enabled": false,
    "explorer.confirmDragAndDrop": false,
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false,
        "latex": false,
        "python": false,
        "lean4": false
    },
    "inlineChat.accessibleDiffView": "on",
    "latex-workshop.intellisense.citation.backend": "biblatex",
    "extensions.experimental.affinity": {
        "ms-toolsai.jupyter": 2,
        "ms-toolsai.jupyter-renderers": 2,
        "ms-python.python": 2,
        "ms-python.vscode-pylance": 2
    },
    "explorer.confirmDelete": false,
    "lean4.goalsAccomplishedDecorationKind": "Circled Checkmark",
    "lean4Goals.solvedMarkerColor": "#00000",
    "lean4Goals.goalPosition": "startOfLine",
    "window.commandCenter": false,
    "chat.commandCenter.enabled": false,
    "workbench.layoutControl.enabled": false,
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "terminal.integrated.suggest.cdPath": "off",
    "terminal.integrated.suggest.enabled": false,
    "terminal.integrated.suggest.inlineSuggestion": "off",
    "workbench.colorTheme": "Dark+",
    "chat.disableAIFeatures": true,
}